{
 "name": "-console",
 "displayName": " Console",
 "description": " 法律智能分析系统控制台 — 案件总览、工作流控制、配置管理",
 "version": "0.1.0",
 "publisher": "",
 "engines": {
 "vscode": "^1.85.0"
 },
 "categories": [
 "Other"
 ],
 "activationEvents": [
 "onView:-cases",
 "onCommand:.openDashboard"
 ],
 "main": "./dist/extension.js",
 "contributes": {
 "viewsContainers": {
 "activitybar": [
 {
 "id": "-container",
 "title": "",
 "icon": "resources/icon.svg"
 }
 ]
 },
 "views": {
 "-container": [
 {
 "id": "-cases",
 "name": "案件列表",
 "icon": "resources/icon.svg"
 },
 {
 "id": "-deadlines",
 "name": "期限告警"
 },
 {
 "id": "-actions",
 "name": "快速操作"
 }
 ]
 },
 "commands": [
 {
 "command": ".openDashboard",
 "title": ": 打开控制台"
 },
 {
 "command": ".refreshCases",
 "title": ": 刷新案件列表",
 "icon": "$(refresh)"
 },
 {
 "command": ".fixCaseStructure",
 "title": ": 修复案件目录结构",
 "icon": "$(wrench)"
 }
 ],
 "menus": {
 "view/title": [
 {
 "command": ".refreshCases",
 "when": "view == -cases",
 "group": "navigation"
 }
 ]
 },
 "configuration": {
 "title": " Console",
 "properties": {
 ".deadlineWarningDays": {
 "type": "number",
 "default": 7,
 "description": "期限告警天数阈值"
 },
 ".autoRefreshInterval": {
 "type": "number",
 "default": 5000,
 "description": "文件监控刷新间隔（毫秒）"
 },
 ".claudeCommandPath": {
 "type": "string",
 "default": "claude",
 "description": "Claude Code CLI 路径"
 }
 }
 }
 },
 "scripts": {
 "vscode:prepublish": "npm run build",
 "build": "webpack --mode production",
 "watch": "webpack --mode development --watch",
 "lint": "eslint src --ext ts",
 "test": "node ./out/test/runTest.js",
 "build:webview": "webpack --mode production --config webpack.webview.js",
 "dev": "webpack --mode development"
 },
 "devDependencies": {
 "@types/js-yaml": "4.0.9",
 "@types/node": "^20.0.0",
 "@types/vscode": "^1.85.0",
 "@vscode/test-electron": "^2.3.0",
 "css-loader": "^6.8.0",
 "style-loader": "^3.3.0",
 "ts-loader": "^9.5.0",
 "typescript": "^5.3.0",
 "webpack": "^5.89.0",
 "webpack-cli": "^5.1.0"
 },
 "dependencies": {
 "js-yaml": "^4.1.0"
 }
}
